# Integrações opcionais — só ativar após homologação
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
LEGACY_CATALOG_API_URL=
LEGACY_CATALOG_API_KEY=
MAPS_PROVIDER=
